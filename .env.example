PORT=4000
NODE_ENV=development
JWT_SECRET=development-only-secret-change-before-deployment
DB_PATH=./server/data/2hands.sqlite

# GMAIL & EMAIL NOTIFICATIONS
# Para makapagpadala ng live confirmation at turn-reminder ("Sila na po") emails sa customers:
# 1. I-enable ang 2-Step Verification sa Google Account (myaccount.google.com/security)
# 2. Gumawa ng "App Password" sa Google (myaccount.google.com/apppasswords)
# 3. Ilagay dito ang Gmail at 16-character App Password:
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=2 Hands Massage & Wellness
